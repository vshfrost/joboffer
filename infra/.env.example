# Скопіюй у infra/.env і впиши власні значення (файл у .gitignore). Значення не комітяться.
# Пароль БД dev-стеку (у контейнері postgres образ бере його з власної змінної, в адресі БД — частина URL).
JOBOFFER_POSTGRES_PASSWORD=

# Вхід через Google (необовʼязково; без цих чотирьох кнопки Google нема, пароль працює).
# Redirect URI у Google Cloud Console має збігатися посимвольно.
JOBOFFER_GOOGLE_CLIENT_ID=
JOBOFFER_GOOGLE_CLIENT_SECRET=
# dev через Vite: http://localhost:5174/api/auth/google/callback
JOBOFFER_GOOGLE_REDIRECT_URI=
# Підпис cookie зі станом OAuth-флоу, щонайменше 32 символи: openssl rand -base64 48
# Логін-гейт MCP (агент): <JOBOFFER_WEB_PUBLIC_URL>/mcp/auth/google/callback; dev http://localhost:5174/mcp/auth/google/callback
JOBOFFER_GOOGLE_GATE_REDIRECT_URI=
JOBOFFER_AUTH_STATE_SECRET=

# Синк пошти (необовʼязково; сервіс mailsync; client id і secret ділить із ним app для відправки). Скринька застосунку в Gmail, яку joboffer
# лише читає, і її OAuth-креди (scope gmail.readonly). Значення створює й вписує оператор.
JOBOFFER_MAIL_ADDRESS=
JOBOFFER_GMAIL_CLIENT_ID=
JOBOFFER_GMAIL_CLIENT_SECRET=
JOBOFFER_GMAIL_REFRESH_TOKEN=

# Відправка листів (необовʼязково; лише сервіс app): окремий refresh token зі scope gmail.send
# (той самий OAuth-клієнт, що вище). Без нього реєстрація закрита. Значення створює й вписує оператор.
JOBOFFER_GMAIL_SEND_REFRESH_TOKEN=
# Листів за ковзні 24 год, не більше (типово 50).
JOBOFFER_MAIL_SEND_DAILY_LIMIT=
