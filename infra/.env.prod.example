# Шаблон /etc/joboffer/env прод-стеку (infra/compose.prod.yaml). Скопіюй на сервер, права 0600, впиши значення.
# Усі значення нижче — заглушки; справжні створює й вписує оператор. Файл не комітиться.

# Пароль БД joboffer (у postgres і в адресі БД застосунку). Приклад генерації: openssl rand -base64 32
JOBOFFER_POSTGRES_PASSWORD=change-me
# Токен remotely-managed Cloudflare Tunnel (Zero Trust → Networks → Tunnels). Ingress у дашборді: http://web:8080
TUNNEL_TOKEN=change-me

# Підпис cookie зі станом OAuth-флоу (веб і логін-гейт MCP), щонайменше 32 символи: openssl rand -base64 48
JOBOFFER_AUTH_STATE_SECRET=change-me-at-least-32-characters-long
# Ключ підпису задач ALTCHA при реєстрації, щонайменше 32 символи; без нього реєстрація закрита.
JOBOFFER_ALTCHA_HMAC_KEY=change-me-at-least-32-characters-long

# Вхід через Google (client id, secret, обидва redirect URI — або жодного з чотирьох Google-полів).
JOBOFFER_GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
JOBOFFER_GOOGLE_CLIENT_SECRET=change-me
# Обидві адреси мають бути вписані в клієнт Google Cloud Console посимвольно.
JOBOFFER_GOOGLE_REDIRECT_URI=https://jobs.example.com/api/auth/google/callback
JOBOFFER_GOOGLE_GATE_REDIRECT_URI=https://jobs.example.com/mcp/auth/google/callback

# Публічний origin вебу (https) і дозволені Host-и агента (JSON-список): обовʼязкові, типових значень нема.
JOBOFFER_WEB_PUBLIC_URL=https://jobs.example.com
JOBOFFER_AGENT_ALLOWED_HOSTS=["jobs.example.com"]
# Скринька застосунку в Gmail (не секрет, обовʼязкова): з неї будується особиста адреса для пересилання листів.
JOBOFFER_MAIL_ADDRESS=mailroom@example.com
# Відправка листів з кодом реєстрації: OAuth-клієнт Gmail і refresh token зі scope gmail.send.
JOBOFFER_GMAIL_CLIENT_ID=change-me.apps.googleusercontent.com
JOBOFFER_GMAIL_CLIENT_SECRET=change-me
JOBOFFER_GMAIL_SEND_REFRESH_TOKEN=change-me
# Листів за ковзні 24 год, не більше (типово 50).
JOBOFFER_MAIL_SEND_DAILY_LIMIT=50

# Необовʼязково (типові значення вже в compose):
# Складність ALTCHA для клієнта, 1..10000000 (типово 100000).
# JOBOFFER_ALTCHA_MAXNUMBER=100000
# Тека PDF на хості (uid 10001, права 0700; типово /srv/joboffer/documents).
# JOBOFFER_DOCUMENTS_HOST_DIR=/srv/joboffer/documents
